# Estas variables se leen del entorno del sistema (la aplicación no carga archivos .env por sí sola).
# Copia este archivo como .env para guardar tus valores; ese archivo nunca se sube a Git.
# Clave con la que se firman las sesiones: al menos 32 caracteres, al azar y distinta en cada instalación.
SECRET_KEY=
# Dónde está la base de datos SQLite, por ejemplo sqlite:///barberia.db
DATABASE_URL=
# Carpeta donde se guardan los respaldos
RESPALDO_DESTINO=
# Zona horaria del negocio; si se deja vacía se usa America/Santiago
ZONA_HORARIA=
# Escribe si para encender /docs, /redoc y /openapi.json (apagados por defecto; no los actives en producción)
DOCS_ACTIVAS=
